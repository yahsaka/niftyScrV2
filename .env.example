# Default: personal data in server memory for this browser session.
# Export private JSON backups; GitHub does not receive this state.
NIFTY_STORAGE=session

# Only for a trusted local / private installation, never a shared public app:
# NIFTY_STORAGE=local
# NIFTY_DB_PATH=.local/workspace.sqlite3

# Optional, explicitly synthetic, isolated read-only demonstration mode:
NIFTY_DEMO=0
